{
  "name": "jobtrail-mailwatch",
  "version": "1.0.0",
  "description": "Standalone sidecar: watches Gmail for job-application updates and pushes status changes to JobTrail after you confirm them.",
  "main": "server.js",
  "type": "module",
  "scripts": {
