# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Can be a brand-new Postgres OR the same Supabase DB JobTrail uses — all
# tables created here are prefixed mw_ so there is no collision.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Encryption key for tokens/passwords at rest ──────────────────────────────
# 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENC_KEY=change_me_64_hex_chars

# ── Groq (email classification) ──────────────────────────────────────────────
# Reuse the key you use for JobTrail, or make a second one. Free.
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# ── Google OAuth (Gmail read-only) ──────────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI must be exactly  <PUBLIC_URL>/oauth/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# ── JobTrail API ────────────────────────────────────────────────────────────
JOBTRAIL_API_URL=https://jobtrail-en88.onrender.com

# ── Shared secrets ──────────────────────────────────────────────────────────
# SYNC_SECRET gates POST /sync (used by the GitHub Actions cron).
# REVIEW_KEY gates the /review page and the setup endpoints.
# Generate each with the same randomBytes one-liner above (32 bytes is plenty).
SYNC_SECRET=change_me
REVIEW_KEY=change_me

# Gmail search filter. Narrow this to a label once you have one, e.g.
#   label:jobs   or   from:(greenhouse.io OR lever.co OR ashbyhq.com)
GMAIL_QUERY=newer_than:3d -in:chats -category:promotions
